{
  "schema_version": 2,
  "name": "agent-native-template",
  "version": "0.3.0",
  "description": "Progressive-context agent kit files for installation into existing projects.",
  "runtime": {
    "primary_host": "codex",
    "supported_hosts": ["codex", "claude-code"],
    "required_commands": ["python", "git", "rg"],
    "optional_commands": ["make", "semble", "serena", "rtk"],
    "optional_integrations": ["understand-anything"],
    "codex_cli_ci_version": "0.146.0"
  },
  "skills": [
    {
      "name": "agent-setup",
      "path": ".agents/skills/agent-setup",
      "required": true,
      "hosts": ["codex"],
      "required_commands": ["python"],
      "optional_commands": ["make"]
    },
    {
      "name": "architecture-decision",
      "path": ".agents/skills/architecture-decision",
      "required": true,
      "hosts": ["codex"],
      "required_commands": [],
      "optional_commands": []
    },
    {
      "name": "code-review",
      "path": ".agents/skills/code-review",
      "required": true,
      "hosts": ["codex"],
      "required_commands": ["git", "rg"],
      "optional_commands": []
    },
    {
      "name": "memory-maintenance",
      "path": ".agents/skills/memory-maintenance",
      "required": true,
      "hosts": ["codex"],
      "required_commands": ["python"],
      "optional_commands": ["make"]
    },
    {
      "name": "plan-evolution",
      "path": ".agents/skills/plan-evolution",
      "required": true,
      "hosts": ["codex"],
      "required_commands": [],
      "optional_commands": []
    },
    {
      "name": "repo-navigator",
      "path": ".agents/skills/repo-navigator",
      "required": true,
      "hosts": ["codex"],
      "required_commands": ["rg"],
      "optional_commands": ["semble", "serena"],
      "optional_integrations": ["understand-anything"]
    },
    {
      "name": "safe-implementation",
      "path": ".agents/skills/safe-implementation",
      "required": true,
      "hosts": ["codex"],
      "required_commands": ["git"],
      "optional_commands": []
    },
    {
      "name": "task-handoff",
      "path": ".agents/skills/task-handoff",
      "required": true,
      "hosts": ["codex"],
      "required_commands": [],
      "optional_commands": []
    },
    {
      "name": "test-debug-loop",
      "path": ".agents/skills/test-debug-loop",
      "required": true,
      "hosts": ["codex"],
      "required_commands": [],
      "optional_commands": []
    }
  ],
  "guardrail_templates": [
    ".codex/templates/hooks.json",
    ".codex/templates/default.rules"
  ],
  "included_harness_files": [
    "AGENTS.override.md.example",
    ".agents/skills/",
    ".claude/agents/",
    ".claude/hooks/",
    ".codex/templates/",
    ".mcp/README.md",
    ".mcp/rtk.md",
    ".mcp/servers.example.json",
    ".mcp/semble.md",
    ".mcp/serena.md",
    ".sembleignore",
    "tools/agent/",
    ".understand-anything/README.md",
    ".understand-anything/.understandignore",
    "docs/agent/",
    "scripts/",
    "eval/agent/",
    "eval/retrieval/",
    "eval/rules/",
    "eval/skills/"
  ],
  "merge_files": [
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "copy_if_missing_files": [
    ".agent/tasks/README.md",
    ".agent/memory/README.md",
    ".agent/memory/index.json",
    ".agent/memory/semantic/project-facts.md",
    ".agent/memory/semantic/conventions.md",
    ".agent/memory/semantic/decisions.md",
    ".agent/memory/procedural/debugging-playbooks.md",
    ".agent/memory/procedural/testing-playbooks.md",
    ".agent/memory/procedural/refactor-playbooks.md",
    ".agent/memory/candidates/README.md",
    ".agent/plans/template.md",
    ".agent/plans/active/.gitkeep",
    ".agent/plans/completed/.gitkeep",
    ".agent/plans/backlog/.gitkeep",
    ".agent/plans/reports/.gitkeep"
  ],
  "project_local_files": [
    "src/",
    "tests/",
    "docs/product/",
    "docs/specs/",
    "docs/adr/",
    ".env",
    ".env.example",
    "package.json",
    "pyproject.toml",
    "Makefile"
  ],
  "excluded_files": [
    ".agent/tasks/*.md",
    ".agent/memory/candidates/*.md",
    ".agent/summaries/",
    ".agent/traces/",
    ".agent/context-cache/",
    "tools/agent/.venv/",
    "tools/agent/python/*/.venv/",
    "tools/agent/node_modules/",
    "tools/agent/bin/",
    "tools/agent/.uv-cache/",
    "tools/agent/.npm-cache/",
    "tools/agent/.hf-cache/",
    "tools/agent/.downloads/",
    ".git/",
    ".venv/",
    "node_modules/",
    "__pycache__/"
  ],
  "symlinks": []
}
